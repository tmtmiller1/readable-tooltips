<?xml version="1.0" encoding="utf-8"?>
<!-- The Mod element's version="1" is the ModInfo SCHEMA version, NOT the
     release version. The release version is <Properties><Version> below. -->
<Mod id="readable-tooltips" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_READABLE_TOOLTIPS_NAME</Name>
        <Description>LOC_MOD_READABLE_TOOLTIPS_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <SpecialThanks>The demographics mod, whose per-tooltip readability nudge this generalizes to the whole game.</SpecialThanks>
        <Package>ReadableTooltipsMod</Package>
        <PackageSortIndex>1000</PackageSortIndex>
        <!-- Cosmetic UI-only mod: no gameplay/database change, so it can be
             injected into ANY session including existing saved games. Without
             this the game treats the mod as save-affecting and silently skips it
             when loading a save it wasn't created with. -->
        <AffectsSavedGames>0</AffectsSavedGames>
        <Version>1.0.4</Version>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <!-- Shell scope: main-menu / front-end tooltips. High LoadOrder so our
             override lands after the base tooltip stylesheet. -->
        <ActionGroup id="readable-tooltips-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/readable-tooltips.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <!-- Game scope: the in-game `#tooltip-root` tooltips (yield amounts,
             decision/reward previews, tech/civic unlock popup). readable-tooltips.js
             wraps TooltipController.reposition to widen the cursor gap BEFORE the
             controller's on-screen clamp, so tooltips clear the cursor yet still
             re-fit on-screen (no clipped tech/civic popup). See the file header. -->
        <ActionGroup id="readable-tooltips-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/readable-tooltips.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModText.xml</File>
    </LocalizedText>
</Mod>
