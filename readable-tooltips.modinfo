<?xml version="1.0" encoding="utf-8"?>
<!-- version="1" on the Mod element is the ModInfo schema version, not the
     release version. The release version is <Properties><Version> below. -->
<Mod id="readable-tooltips" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_MOD_READABLE_TOOLTIPS_NAME</Name>
        <Description>LOC_MOD_READABLE_TOOLTIPS_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <SpecialThanks>The demographics mod, whose per-tooltip readability nudge this generalizes to the whole game.</SpecialThanks>
        <Package>ReadableTooltipsMod</Package>
        <PackageSortIndex>1000</PackageSortIndex>
        <!-- UI-only mod with no gameplay or database change, so it can load into
             any session, including existing saves. Without this flag the game
             treats the mod as save-affecting and skips it when loading a save it
             wasn't created with. -->
        <AffectsSavedGames>0</AffectsSavedGames>
        <Version>1.0.7</Version>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always">
            <AlwaysMet></AlwaysMet>
        </Criteria>
        <!-- Civilopedia History Corrections: the history text on six independent-power pages from Civilopedia
             Expanded: Independents. Each group needs that mod in use, so without it the game's pages are left as
             they are. The text in history-corrections/ is a copy kept in step with the standalone mod. -->
        <Criteria id="history-corrections-antiquity">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration-sengoku">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <ModInUse>sengoku</ModInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration-mlcs">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <ModInUse>ml-city-states-expanded</ModInUse>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <!-- Shell scope: main-menu tooltips. High LoadOrder so the script runs
             after the base tooltip code it wraps. -->
        <ActionGroup id="readable-tooltips-shell" scope="shell" criteria="always">
            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/readable-tooltips.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <!-- Game scope: the in-game tooltips. readable-tooltips.js widens the
             cursor gap inside each tooltip system's own placement code, before
             its on-screen clamp, so tooltips clear the cursor and still fit
             on-screen. See the README. -->
        <ActionGroup id="readable-tooltips-game" scope="game" criteria="always">
            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/ModText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/readable-tooltips.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <!-- Civilopedia History Corrections, loaded at 1000 to come after Civilopedia Expanded's groups (10, 100
             and 210). Text only. -->
        <ActionGroup id="history-corrections-antiquity-text" scope="game" criteria="history-corrections-antiquity">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/antiquity-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-text" scope="game" criteria="history-corrections-exploration">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-sengoku-text" scope="game" criteria="history-corrections-exploration-sengoku">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-sengoku-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-mlcs-text" scope="game" criteria="history-corrections-exploration-mlcs">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-mlcs-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
    </ActionGroups>
    <LocalizedText>
        <File>text/en_us/ModText.xml</File>
    </LocalizedText>
</Mod>
